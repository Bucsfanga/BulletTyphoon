  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a547ba8c44174934991d4667f0352d9e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  customTutorialText: 'I don''t trust the look of that platform up ahead, it looks
    like it could fall apart at any moment! A destructible platform will start breaking
    down as soon as you land on it! When a destructible platform begins to deteriorate
    it will turn yellow and when destruction is imminent it will turn bright red!


    Looks
    like you''re in luck, theres a moving platform nearby to help you reach the next
    stable set of platforms! Moving platforms can be easily identified by their deep
    green color!'
  customTutorialImage: {fileID: 21300000, guid: f2a2cd3cafd94324faafcba2ed5455f8, type: 3}
